// InstaDM247 — domain model
// See docs/ARCHITECTURE.md for how these fit together and docs/FEATURES.md for scope.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  /// Platform staff, not workspace membership. none | support | admin.
  /// Bootstrapped from PLATFORM_ADMIN_EMAILS at sign-in; see src/lib/admin.ts.
  platformRole String @default("none")

  /// Set when the user proves they own the address. See docs/EMAIL.md.
  emailVerifiedAt DateTime?

  memberships Membership[]
  sessions    Session[]
  emailTokens EmailToken[]
  auditEvents AdminAuditLog[] @relation("AuditActor")
  adminNotes  AdminNote[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  userAgent String?
  ip        String?
  createdAt DateTime @default(now())

  /// Set when platform staff are acting as this user. Such a session is
  /// read-only for anything outbound — see src/lib/impersonation.ts.
  impersonatedByUserId String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  /// The RESOLVED plan — free | pro | business | unlimited. Recomputed by
  /// src/lib/billing/resolve.ts whenever a subscription, an override or the
  /// clock changes it, so enforcement reads one column. See docs/BILLING.md.
  planKey   String   @default("free")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Dodo's customer_id for this workspace, created before its first checkout.
  /// Webhooks are mapped back to the workspace through this.
  billingCustomerId  String?   @unique
  /// Staff-granted plan that wins over any subscription until it expires.
  /// Every workspace that existed before billing shipped carries "unlimited".
  planOverride       String?
  planOverrideReason String?
  planOverrideUntil  DateTime?
  planOverrideById   String?

  /// Suspension. The reason is shown to the customer at sign-in, and the
  /// dispatcher refuses to send for a suspended workspace.
  suspendedAt     DateTime?
  suspendedReason String?
  suspendedById   String?

  memberships      Membership[]
  accounts         InstagramAccount[]
  templates        Template[]
  trackedLinks     TrackedLink[]
  leadForms        LeadForm[]
  segments         Segment[]
  broadcasts       Broadcast[]
  aiAgents         AiAgent[]
  knowledgeDocs    KnowledgeDoc[]
  couponPools      CouponPool[]
  bioPages         BioPage[]
  apiKeys          ApiKey[]
  webhookEndpoints WebhookEndpoint[]
  integrations     Integration[]
  adminNotes       AdminNote[]
  subscriptions    Subscription[]
  usageCounters    UsageCounter[]
  paymentEvents    PaymentEvent[]
}

/// Every privileged action platform staff take. Impersonation touches the DMs
/// of people who never signed up here, so "who looked, when, and why" is the
/// record that makes support access defensible. Append-only by convention.
model AdminAuditLog {
  id          String   @id @default(cuid())
  actorUserId String
  action      String   // impersonate.start | impersonate.end | workspace.suspend | ...
  targetType  String   // workspace | user | account
  targetId    String
  reason      String?
  meta        Json?
  ip          String?
  userAgent   String?
  createdAt   DateTime @default(now())

  actor User @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: Cascade)

  @@index([actorUserId, createdAt])
  @@index([targetType, targetId, createdAt])
  @@index([action, createdAt])
}

/// Internal notes staff leave on a customer. Never shown to the customer.
model AdminNote {
  id          String   @id @default(cuid())
  workspaceId String
  authorId    String
  body        String
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
}

model Membership {
  id          String   @id @default(cuid())
  userId      String
  workspaceId String
  role        String   @default("owner") // owner | admin | member — enforcement is Phase 2
  createdAt   DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([workspaceId])
}

// ---------------------------------------------------------------------------
// Instagram connection
// ---------------------------------------------------------------------------

model InstagramAccount {
  id          String @id @default(cuid())
  workspaceId String

  // Instagram-scoped identifiers
  //
  // Two IDs, because Instagram Login hands back two and they are not
  // interchangeable. `igUserId` is the Instagram professional account ID (the
  // `user_id` field on /me), which is what Graph calls and webhook payloads
  // use. `igScopedId` is the app-scoped ID returned by the token exchange.
  // Which of the two appears in `entry.id` has moved between API versions, so
  // inbound events are matched against either.
  igUserId          String  @unique
  igScopedId        String? @unique
  username          String
  name              String?
  profilePictureUrl String?
  accountType       String?
  followersCount    Int     @default(0)
  mediaCount        Int     @default(0)

  // Encrypted at rest via src/lib/crypto.ts — never log these.
  accessTokenEnc String?
  tokenExpiresAt DateTime?
  lastRefreshAt  DateTime?
  scopes         String[]  @default([])

  status               String    @default("connected") // connected | token_expired | revoked | demo
  webhookSubbed        Boolean   @default(false)
  /// Why the last subscribe attempt failed, verbatim from Meta. Surfaced in the
  /// dashboard: the usual causes are app-level config the customer cannot fix by
  /// reconnecting, so telling them to reconnect without this is a dead end.
  webhookError         String?
  /// Fields actually subscribed. Meta rejects the whole call if one field is not
  /// enabled on the app, so we fall back to the core set and record the gap.
  webhookFields        String[]  @default([])
  lastWebhookTryAt     DateTime?
  lastSyncAt           DateTime?
  // Safety
  slowDownUntil        DateTime?
  automationPaused     Boolean   @default(false)
  pausedReason         String?
  /// Viral Post Protection: arm Slow Down proactively when inbound comments
  /// spike, instead of waiting for Instagram to throttle us.
  viralProtection      Boolean   @default(true)
  viralThresholdPerMin Int       @default(40)
  lastViralTriggerAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace          Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  automations        Automation[]
  contacts           Contact[]
  conversations      Conversation[]
  media              Media[]
  iceBreakers        IceBreaker[]
  persistentMenu     PersistentMenu?
  webhookEvents      WebhookEvent[]
  flowRuns           FlowRun[]
  analytics          AnalyticsEvent[]
  dailyStats         DailyStat[]
  suppressions       SuppressionEntry[]
  plannedAutomations PlannedAutomation[]
  commentReplies     CommentReplyLog[]
  broadcasts         Broadcast[]
  scheduledPosts     ScheduledPost[]
  rewindJobs         RewindJob[]
  bioPages           BioPage[]

  @@index([workspaceId])
}

/// Cached Instagram media so the media picker and analytics don't hammer the API.
model Media {
  id            String    @id @default(cuid())
  accountId     String
  igMediaId     String
  caption       String?
  mediaType     String? // IMAGE | VIDEO | CAROUSEL_ALBUM | REELS
  mediaUrl      String?
  thumbnailUrl  String?
  permalink     String?
  timestamp     DateTime?
  commentsCount Int       @default(0)
  likeCount     Int       @default(0)
  // Ads / boosted content (from the comments webhook)
  adId          String?
  adTitle       String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  account     InstagramAccount  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  automations AutomationMedia[]

  @@unique([accountId, igMediaId])
  @@index([accountId])
}

// ---------------------------------------------------------------------------
// Automations & flows
// ---------------------------------------------------------------------------

model Automation {
  id          String  @id @default(cuid())
  accountId   String
  name        String
  description String?

  /// COMMENT | LIVE_COMMENT | STORY_REPLY | STORY_MENTION | DM_KEYWORD |
  /// ICE_BREAKER | POSTBACK | REFERRAL | AD_COMMENT
  triggerType String

  /// SPECIFIC | ALL_MEDIA | UNIVERSAL | AD  — which content it listens to
  scope String @default("SPECIFIC")

  /// ALL | KEYWORD — LinkDM's "All Comments" vs "Specific Keywords".
  /// STORY_REPLY also takes REACTION (emoji-only replies — how a story
  /// reaction arrives) and REPLY (written replies only).
  matchMode String @default("KEYWORD")

  keywords         String[] @default([])
  negativeKeywords String[] @default([])
  /// CONTAINS | EXACT | STARTS_WITH | REGEX
  matchType        String   @default("CONTAINS")
  caseSensitive    Boolean  @default(false)
  fuzzyMatch       Boolean  @default(false)

  enabled  Boolean @default(true)
  priority Int     @default(0)

  /// ONCE | ALWAYS | ONCE_PER_MEDIA | COOLDOWN — per-contact re-entry policy
  reentryPolicy   String @default("ONCE_PER_MEDIA")
  cooldownMinutes Int?

  /// Optional active window (local schedule)
  scheduleStart DateTime?
  scheduleEnd   DateTime?

  /// Also post a public reply in the comment thread
  publicReplyEnabled Boolean  @default(false)
  publicReplies      String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account    InstagramAccount    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  flow       Flow?
  media      AutomationMedia[]
  runs       FlowRun[]
  analytics  AnalyticsEvent[]
  dailyStats DailyStat[]
  planned    PlannedAutomation[]
  rewinds    RewindJob[]

  @@index([accountId, triggerType, enabled])
}

model AutomationMedia {
  automationId String
  mediaId      String

  automation Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  media      Media      @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([automationId, mediaId])
  @@index([mediaId])
}

model Flow {
  id           String @id @default(cuid())
  automationId String @unique
  name         String @default("Flow")

  /// Zod-validated graph. See src/lib/engine/schema.ts
  nodes Json @default("[]")
  edges Json @default("[]")

  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  automation Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
}

/// LinkDM's "DM Planner": a draft automation attached to a caption draft-code,
/// activated automatically when the post carrying that code goes live.
model PlannedAutomation {
  id             String    @id @default(cuid())
  accountId      String
  automationId   String?
  name           String
  /// DRAFT_CODE — look for the code in a caption · NEXT_POST — attach to
  /// whatever publishes next (LinkDM's "Next Post")
  mode           String    @default("DRAFT_CODE")
  draftCode      String
  status         String    @default("waiting") // waiting | matched | expired | cancelled
  matchedMediaId String?
  matchedAt      DateTime?
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  account    InstagramAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  automation Automation?      @relation(fields: [automationId], references: [id], onDelete: SetNull)

  @@unique([accountId, draftCode])
  @@index([accountId, status])
}

// ---------------------------------------------------------------------------
// People & conversations
// ---------------------------------------------------------------------------

model Contact {
  id        String @id @default(cuid())
  accountId String

  /// Instagram-scoped ID (IGSID) — unique per app+account, not a public IG id.
  igsid             String
  username          String?
  name              String?
  profilePicUrl     String?
  followerCount     Int?
  /// From the User Profile API — powers the Follower Growth Tool
  isFollower        Boolean?
  followerCheckedAt DateTime?

  tags         String[] @default([])
  customFields Json     @default("{}")
  notes        String?

  /// Rolling 24-hour messaging window bookkeeping
  lastInteractionAt DateTime?
  windowExpiresAt   DateTime?

  optedOut   Boolean   @default(false)
  optedOutAt DateTime?

  /// Last automated DM that carried the Free-plan branding line. It goes out at
  /// most once a day per person — see src/lib/branding.ts.
  brandedAt DateTime?

  firstSeenAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  account       InstagramAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  conversations Conversation[]
  messages      Message[]
  flowRuns      FlowRun[]
  leadResponses LeadResponse[]
  analytics     AnalyticsEvent[]
  linkClicks    LinkClick[]
  couponCodes   CouponCode[]

  @@unique([accountId, igsid])
  @@index([accountId, lastInteractionAt])
  @@index([accountId, tags])
}

model Conversation {
  id        String @id @default(cuid())
  accountId String
  contactId String

  igConversationId   String?
  lastMessageAt      DateTime?
  lastMessagePreview String?
  unreadCount        Int       @default(0)
  status             String    @default("open") // open | closed | snoozed
  /// Set when a human takes over — pauses automation for this thread
  humanTakeover      Boolean   @default(false)
  takeoverAt         DateTime?
  assignedToUserId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account  InstagramAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  contact  Contact          @relation(fields: [contactId], references: [id], onDelete: Cascade)
  messages Message[]
  flowRuns FlowRun[]

  @@unique([accountId, contactId])
  @@index([accountId, lastMessageAt])
}

model Message {
  id             String @id @default(cuid())
  conversationId String
  contactId      String

  igMessageId String? @unique
  direction   String // inbound | outbound
  /// text | image | video | audio | template | story_reply | story_mention | share | reaction
  kind        String  @default("text")
  text        String?
  payload     Json?

  /// automation | human | ai | broadcast
  source        String  @default("automation")
  /// Only ever true for messages a real human typed. See docs/META_API.md §6.
  humanAgentTag Boolean @default(false)

  status      String    @default("sent") // queued | sent | delivered | seen | failed | skipped
  failReason  String?
  skipReason  String?
  sentAt      DateTime?
  deliveredAt DateTime?
  seenAt      DateTime?

  flowRunId String?
  nodeId    String?

  createdAt DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  contact      Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  flowRun      FlowRun?     @relation(fields: [flowRunId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
  @@index([contactId])
}

/// Enforces "one private reply per comment id, ever" (docs/META_API.md §5).
model CommentReplyLog {
  id          String   @id @default(cuid())
  accountId   String
  igCommentId String
  kind        String   @default("private") // private | public
  status      String   @default("sent") // sent | failed
  createdAt   DateTime @default(now())

  account InstagramAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, igCommentId, kind])
  @@index([accountId])
}

model SuppressionEntry {
  id        String   @id @default(cuid())
  accountId String
  igsid     String
  reason    String // opted_out | manual_block | policy | bounced
  note      String?
  createdAt DateTime @default(now())

  account InstagramAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, igsid])
}

// ---------------------------------------------------------------------------
// Flow execution
// ---------------------------------------------------------------------------

model FlowRun {
  id             String  @id @default(cuid())
  accountId      String
  automationId   String
  contactId      String
  conversationId String?

  status String @default("running") // running | waiting | completed | halted | failed

  triggerType    String
  triggerPayload Json?
  /// Variables collected during the run (lead form answers, etc.)
  variables      Json   @default("{}")

  currentNodeId String?
  resumeAt      DateTime?
  haltReason    String?
  error         String?

  startedAt   DateTime  @default(now())
  completedAt DateTime?

  account       InstagramAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  automation    Automation       @relation(fields: [automationId], references: [id], onDelete: Cascade)
  contact       Contact          @relation(fields: [contactId], references: [id], onDelete: Cascade)
  conversation  Conversation?    @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  steps         FlowRunStep[]
  messages      Message[]
  leadResponses LeadResponse[]

  @@index([accountId, status])
  @@index([automationId, startedAt])
  @@index([status, resumeAt])
  @@index([contactId])
}

/// One row per node entered — this is what the funnel/drop-off chart reads.
model FlowRunStep {
  id        String    @id @default(cuid())
  flowRunId String
  nodeId    String
  nodeType  String
  status    String // entered | completed | skipped | failed | waiting
  detail    Json?
  error     String?
  enteredAt DateTime  @default(now())
  endedAt   DateTime?

  flowRun FlowRun @relation(fields: [flowRunId], references: [id], onDelete: Cascade)

  @@index([flowRunId])
  @@index([nodeId, status])
}

// ---------------------------------------------------------------------------
// Content assets
// ---------------------------------------------------------------------------

model Template {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  category    String   @default("general")
  /// A serialized message payload (text / buttons / carousel)
  payload     Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model IceBreaker {
  id           String   @id @default(cuid())
  accountId    String
  /// Max 80 chars, max 5 per account, Instagram displays 4 (docs/META_API.md §8)
  question     String
  order        Int      @default(0)
  /// Which automation answers this starter
  automationId String?
  payload      Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  account InstagramAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
}

model PersistentMenu {
  id        String   @id @default(cuid())
  accountId String   @unique
  items     Json     @default("[]")
  enabled   Boolean  @default(false)
  updatedAt DateTime @updatedAt

  account InstagramAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

model TrackedLink {
  id          String   @id @default(cuid())
  workspaceId String
  code        String   @unique
  destination String
  label       String?
  clickCount  Int      @default(0)
  createdAt   DateTime @default(now())

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  clicks    LinkClick[]

  @@index([workspaceId])
}

model LinkClick {
  id        String   @id @default(cuid())
  linkId    String
  contactId String?
  flowRunId String?
  userAgent String?
  createdAt DateTime @default(now())

  link    TrackedLink @relation(fields: [linkId], references: [id], onDelete: Cascade)
  contact Contact?    @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([linkId, createdAt])
}

// ---------------------------------------------------------------------------
// Lead capture (SendDM "Collect User Data")
// ---------------------------------------------------------------------------

model LeadForm {
  id             String   @id @default(cuid())
  workspaceId    String
  name           String
  /// FORM | SURVEY | QUIZ | ORDER
  kind           String   @default("FORM")
  /// [{ id, label, type, required, options[], validation }]
  fields         Json     @default("[]")
  successMessage String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  responses LeadResponse[]

  @@index([workspaceId])
}

model LeadResponse {
  id        String   @id @default(cuid())
  formId    String
  contactId String
  flowRunId String?
  answers   Json     @default("{}")
  score     Int?
  completed Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  form    LeadForm @relation(fields: [formId], references: [id], onDelete: Cascade)
  contact Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  flowRun FlowRun? @relation(fields: [flowRunId], references: [id], onDelete: SetNull)

  @@index([formId, createdAt])
  @@index([contactId])
}

// ---------------------------------------------------------------------------
// Audiences & broadcasts
// ---------------------------------------------------------------------------

model Segment {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  /// Serialized filter: tags, fields, window eligibility, activity recency
  filter      Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace  Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  broadcasts Broadcast[]

  @@index([workspaceId])
}

model Broadcast {
  id          String  @id @default(cuid())
  workspaceId String
  accountId   String
  segmentId   String?
  name        String
  payload     Json

  /// BROADCAST | REENGAGE — SendDM's "Smart Re-engage" is a recurring broadcast
  kind        String    @default("BROADCAST")
  status      String    @default("draft") // draft | scheduled | sending | sent | failed | cancelled
  /// Why it failed, in words the customer can act on.
  error       String?
  scheduledAt DateTime?
  startedAt   DateTime?
  completedAt DateTime?

  /// For REENGAGE: how long after last interaction to nudge, and how often
  reengageAfterHours Int?
  recurring          Boolean @default(false)
  cronExpression     String?

  targetCount   Int @default(0)
  eligibleCount Int @default(0)
  sentCount     Int @default(0)
  failedCount   Int @default(0)
  skippedCount  Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account   InstagramAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  segment   Segment?         @relation(fields: [segmentId], references: [id], onDelete: SetNull)

  @@index([workspaceId, status])
  @@index([status, scheduledAt])
}

// ---------------------------------------------------------------------------
// AI
// ---------------------------------------------------------------------------

model AiAgent {
  id               String   @id @default(cuid())
  workspaceId      String
  name             String   @default("Assistant")
  enabled          Boolean  @default(false)
  persona          String   @default("A friendly, concise assistant for an Instagram creator.")
  tone             String   @default("friendly")
  language         String   @default("auto")
  /// Guardrails
  maxTurns         Int      @default(6)
  bannedTopics     String[] @default([])
  fallbackMessage  String   @default("Let me get a human to help with that — one moment!")
  handoffOnUnknown Boolean  @default(true)
  model            String   @default("claude-sonnet-5")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  docs      KnowledgeDoc[]

  @@index([workspaceId])
}

model KnowledgeDoc {
  id          String   @id @default(cuid())
  workspaceId String
  agentId     String?
  title       String
  content     String
  sourceUrl   String?
  /// Simple token frequency index — good enough for FAQ-scale retrieval
  keywords    String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agent     AiAgent?  @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

// ---------------------------------------------------------------------------
// Observability
// ---------------------------------------------------------------------------

model WebhookEvent {
  id        String  @id @default(cuid())
  accountId String?

  /// Idempotency key derived from the provider payload (comment id / message id)
  dedupeKey   String    @unique
  field       String
  payload     Json
  processed   Boolean   @default(false)
  processedAt DateTime?
  error       String?
  createdAt   DateTime  @default(now())

  account InstagramAccount? @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, createdAt])
  @@index([processed])
}

model AnalyticsEvent {
  id           String  @id @default(cuid())
  accountId    String
  automationId String?
  contactId    String?

  /// trigger_fired | message_sent | message_delivered | message_seen | link_clicked |
  /// follow_gained | form_completed | node_entered | flow_completed | send_skipped | send_failed
  type      String
  nodeId    String?
  value     Float?
  meta      Json?
  createdAt DateTime @default(now())

  account    InstagramAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  automation Automation?      @relation(fields: [automationId], references: [id], onDelete: Cascade)
  contact    Contact?         @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([accountId, type, createdAt])
  @@index([automationId, createdAt])
}

model DailyStat {
  id           String   @id @default(cuid())
  accountId    String
  automationId String?
  date         DateTime @db.Date

  triggered    Int @default(0)
  sent         Int @default(0)
  delivered    Int @default(0)
  opened       Int @default(0)
  clicked      Int @default(0)
  failed       Int @default(0)
  skipped      Int @default(0)
  newFollowers Int @default(0)
  leads        Int @default(0)

  account    InstagramAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  automation Automation?      @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@unique([accountId, automationId, date])
  @@index([accountId, date])
}

// ---------------------------------------------------------------------------
// Coupons (LinkDM "DM Coupons")
// ---------------------------------------------------------------------------

/// A pool of codes. `mode` decides whether everyone gets the same code or each
/// person gets their own from the pool — the latter is why `CouponCode` exists.
model CouponPool {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  /// SHARED — one code for everyone · UNIQUE — one code per contact
  mode        String    @default("UNIQUE")
  /// Used when mode = SHARED
  sharedCode  String?
  description String?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  codes     CouponCode[]

  @@index([workspaceId])
}

model CouponCode {
  id        String    @id @default(cuid())
  poolId    String
  code      String
  /// Set the moment it's handed out, so a code is never issued twice.
  contactId String?
  issuedAt  DateTime?
  createdAt DateTime  @default(now())

  pool    CouponPool @relation(fields: [poolId], references: [id], onDelete: Cascade)
  contact Contact?   @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@unique([poolId, code])
  /// One code per contact per pool — enforced by the database, not by hope.
  @@unique([poolId, contactId])
  @@index([poolId, issuedAt])
}

// ---------------------------------------------------------------------------
// Link in Bio (SendDM)
// ---------------------------------------------------------------------------

model BioPage {
  id          String  @id @default(cuid())
  workspaceId String
  accountId   String?

  slug      String  @unique
  title     String
  bio       String?
  avatarUrl String?
  theme     String  @default("comic")
  published Boolean @default(true)
  /// The only genuine white-label surface we have.
  showBadge Boolean @default(true)

  viewCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account   InstagramAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  blocks    BioBlock[]
  views     BioPageView[]

  @@index([workspaceId])
}

model BioBlock {
  id         String   @id @default(cuid())
  pageId     String
  /// LINK | HEADING | TEXT | SOCIAL | EMAIL | WHATSAPP | PRODUCT
  kind       String   @default("LINK")
  label      String
  url        String?
  subtitle   String?
  imageUrl   String?
  order      Int      @default(0)
  enabled    Boolean  @default(true)
  clickCount Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  page   BioPage         @relation(fields: [pageId], references: [id], onDelete: Cascade)
  clicks BioBlockClick[]

  @@index([pageId, order])
}

model BioBlockClick {
  id        String   @id @default(cuid())
  blockId   String
  referrer  String?
  userAgent String?
  createdAt DateTime @default(now())

  block BioBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)

  @@index([blockId, createdAt])
}

model BioPageView {
  id        String   @id @default(cuid())
  pageId    String
  referrer  String?
  createdAt DateTime @default(now())

  page BioPage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId, createdAt])
}

// ---------------------------------------------------------------------------
// Content scheduling (SendDM "Schedule & Auto-Post")
// ---------------------------------------------------------------------------

model ScheduledPost {
  id        String @id @default(cuid())
  accountId String

  /// IMAGE | VIDEO | REELS | CAROUSEL
  mediaType String   @default("IMAGE")
  caption   String?
  /// Public HTTPS URLs Instagram can fetch. Multiple = carousel.
  mediaUrls String[] @default([])
  thumbUrl  String?

  scheduledAt DateTime
  status      String    @default("scheduled") // scheduled | publishing | published | failed | cancelled
  publishedAt DateTime?
  igMediaId   String?
  error       String?
  attempts    Int       @default(0)

  /// Automations to switch on and attach the moment this post goes live.
  attachAutomationIds String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account InstagramAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, status])
  @@index([status, scheduledAt])
}

// ---------------------------------------------------------------------------
// Public API & integrations
// ---------------------------------------------------------------------------

model ApiKey {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  /// Only a hash is stored — the plaintext key is shown once at creation.
  keyHash     String    @unique
  /// First 12 chars, for recognising a key in the list.
  prefix      String
  scopes      String[]  @default(["read"])
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

/// Outbound webhooks for the customer's own systems.
model WebhookEndpoint {
  id           String    @id @default(cuid())
  workspaceId  String
  url          String
  /// Events to deliver: contact.created, lead.captured, flow.completed, …
  events       String[]  @default([])
  secret       String
  enabled      Boolean   @default(true)
  lastStatus   Int?
  lastFiredAt  DateTime?
  failureCount Int       @default(0)
  createdAt    DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

/// Native lead destinations (LinkDM's "Connect lead forms to Kit and Flodesk").
model Integration {
  id          String    @id @default(cuid())
  workspaceId String
  /// kit | flodesk
  provider    String
  name        String
  /// Encrypted at rest, like every other credential.
  apiKeyEnc   String
  /// Provider-specific target: a Kit form id, a Flodesk segment id.
  targetId    String?
  targetName  String?
  enabled     Boolean   @default(true)
  lastSyncAt  DateTime?
  lastError   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, provider, targetId])
  @@index([workspaceId])
}

// ---------------------------------------------------------------------------
// Rewind (LinkDM "Backsend DMs to eligible comments")
// ---------------------------------------------------------------------------

model RewindJob {
  id           String  @id @default(cuid())
  accountId    String
  automationId String
  mediaId      String?

  status String @default("pending") // pending | running | completed | failed | cancelled

  eligibleCount Int @default(0)
  sentCount     Int @default(0)
  skippedCount  Int @default(0)
  failedCount   Int @default(0)

  startedAt   DateTime?
  completedAt DateTime?
  error       String?
  createdAt   DateTime  @default(now())

  account    InstagramAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  automation Automation       @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@index([accountId, status])
}

// --- Billing -----------------------------------------------------------------
// See docs/BILLING.md.

/// One row per provider subscription. History is kept: a workspace that
/// cancels and resubscribes has two rows, and the trace needs both.
model Subscription {
  id          String @id @default(cuid())
  workspaceId String

  provider               String @default("dodo")
  providerSubscriptionId String @unique
  providerCustomerId     String
  providerProductId      String

  /// Mapped from the product ID. free | pro | business
  planKey  String
  /// month | year
  interval String
  /// Dodo's status, verbatim: pending | active | on_hold | paused | cancelled
  /// | failed | expired | past_due
  status   String

  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelAtPeriodEnd  Boolean   @default(false)
  cancelledAt        DateTime?
  /// Dodo's past_due_ends_at — the end of its dunning grace window.
  graceEndsAt        DateTime?

  /// Timestamp of the newest event applied. An older event arriving late is
  /// recorded but not applied, so a retry can never roll the state backwards.
  lastEventAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

/// Monthly usage, one row per workspace × UTC calendar month × metric.
/// Incremented with a conditional UPDATE so a limit can never be overshot.
model UsageCounter {
  id          String   @id @default(cuid())
  workspaceId String
  /// YYYY-MM, UTC
  period      String
  /// dms | ai_replies | helper
  metric      String
  count       Int      @default(0)
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, period, metric])
}

/// The payment trace: every webhook hit and every call we make to the
/// provider, written before anything else happens. See docs/BILLING.md.
model PaymentEvent {
  id        String @id @default(cuid())
  provider  String @default("dodo")
  /// inbound (a webhook) | outbound (a call we made)
  direction String @default("inbound")

  /// The webhook-id header. Not unique: a retry is a second hit and is logged
  /// as one, marked duplicate if the first was already processed.
  webhookId String?
  /// The event type, or for outbound calls e.g. "checkout.create".
  type      String?

  /// Resolved workspace; null until matched, or if it never was.
  workspaceId            String?
  providerCustomerId     String?
  providerSubscriptionId String?
  providerPaymentId      String?
  /// Minor units, as the provider reports them.
  amount   Int?
  currency String?

  signatureValid Boolean?
  /// processed | ignored | duplicate | unmatched | rejected | failed | ok
  status         String
  error          String?
  /// What happened, in words — "plan pro → business", "older than the last
  /// applied event, not applied". Distinct from `error`, which is for failures.
  note           String?
  /// Parsed body; capped for rejected hits, which are unauthenticated input.
  payload        Json?
  httpStatus     Int?

  receivedAt  DateTime  @default(now())
  processedAt DateTime?

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([workspaceId, receivedAt])
  @@index([status, receivedAt])
  @@index([type])
  @@index([webhookId])
}

// --- Email -------------------------------------------------------------------
// See docs/EMAIL.md.

/// Single-use tokens for email verification and password reset. Only the
/// SHA-256 of the token is stored, like API keys: the database alone can't be
/// used to take over an account.
model EmailToken {
  id        String    @id @default(cuid())
  userId    String
  /// verify | reset
  kind      String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind])
}

/// Every email the platform sends or tries to, for tracing. The body is never
/// stored, and neither are the inputs of templates that carry a secret — a
/// verification or reset link sitting in this table would let anyone who can
/// read it take over the account.
model EmailMessage {
  id       String @id @default(cuid())
  to       String
  from     String
  /// accounts | billing | alerts
  category String
  template String
  subject  String
  /// Non-secret render inputs, kept so a failed send can be retried.
  /// Always null for templates that carry a secret.
  params   Json?
  /// Makes a send idempotent: a second send with the same key is a no-op.
  dedupeKey String? @unique

  /// queued | sent | failed | skipped
  status            String
  providerMessageId String?
  error             String?
  attempts          Int       @default(0)

  userId      String?
  workspaceId String?

  createdAt DateTime  @default(now())
  sentAt    DateTime?

  @@index([workspaceId, createdAt])
  @@index([status, createdAt])
  @@index([to])
}

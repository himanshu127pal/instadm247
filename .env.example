# ---------------------------------------------------------------------------
# InstaDM247 environment
# Copy to .env and fill in. The app boots and the whole UI works WITHOUT the
# Meta credentials — only live Instagram calls are disabled until they're set.
# ---------------------------------------------------------------------------

# Core -----------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/instadm247"
REDIS_URL="redis://localhost:6379"
APP_URL="http://localhost:3000"

# 32+ char secrets. Generate with: openssl rand -base64 48
SESSION_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
# Exactly 32 bytes, base64 encoded. Generate with: openssl rand -base64 32
ENCRYPTION_KEY="change-me-base64-32-bytes-key-goes-right-here=="

# Meta / Instagram -----------------------------------------------------------
# Add these when deploying. developers.facebook.com → your app → Instagram →
# API setup with Instagram login → "3. Set up Instagram business login" →
# Business login settings.
#
# Use the INSTAGRAM app ID and secret shown there — NOT the Facebook App ID and
# secret from App settings → Basic. They are different numbers, and the Facebook
# one fails at instagram.com/oauth/authorize with "Invalid platform app".
META_APP_ID=""
META_APP_SECRET=""
# Must exactly match the Redirect URL configured in the App Dashboard.
META_REDIRECT_URI="http://localhost:3000/api/instagram/callback"
# Any random string; must match what you enter in the App Dashboard webhook config.
META_WEBHOOK_VERIFY_TOKEN="change-me-webhook-verify-token"
META_API_VERSION="v23.0"

# Platform admin -------------------------------------------------------------
# Comma-separated emails. These people get /admin. Being listed here is what
# grants access — there is no invite UI, so revoking is a deploy, which is the
# right shape for a role that can read every customer's messages.
# admin   = everything, including suspending customers
# support = read, impersonate, leave notes
PLATFORM_ADMIN_EMAILS=""
PLATFORM_SUPPORT_EMAILS=""

# AI (optional) --------------------------------------------------------------
# Without this the AI agent node falls back to its configured fallback message.
ANTHROPIC_API_KEY=""

# Safety tuning (optional; sensible defaults in src/lib/env.ts) ---------------
# Conservative caps, well under Meta's published limits. See docs/META_API.md §7.
RATE_LIMIT_MESSAGES_PER_HOUR="180"
RATE_LIMIT_PRIVATE_REPLIES_PER_HOUR="600"

# Billing — Dodo Payments ------------------------------------------------------
# See docs/BILLING.md. Nothing is enforced and no customer can check out until
# BILLING_ENABLED is true; with it off, every workspace is treated as unlimited.
# Staff can still run a test checkout, which is how to verify the setup first.
BILLING_ENABLED=false
DODO_PAYMENTS_API_KEY=""
# whsec_… — from the webhook you register in Dodo at <APP_URL>/api/webhooks/dodo
DODO_PAYMENTS_WEBHOOK_SECRET=""
# test_mode or live_mode
DODO_PAYMENTS_ENVIRONMENT=test_mode
# Product IDs of the four subscription products you create in Dodo.
DODO_PRODUCT_PRO_MONTHLY=""
DODO_PRODUCT_PRO_YEARLY=""
DODO_PRODUCT_BUSINESS_MONTHLY=""
DODO_PRODUCT_BUSINESS_YEARLY=""

# Email — Amazon SES -----------------------------------------------------------
# See docs/EMAIL.md. Unset = nothing is sent; every email is logged as skipped
# and the app works normally. The server refuses to start with ses and no region.
EMAIL_PROVIDER=""
SES_REGION=""
# Keys for an IAM user allowed only ses:SendEmail. Read by the AWS SDK directly.
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
# Optional: an SES configuration set for bounce/complaint event publishing.
SES_CONFIGURATION_SET=""
# Optional overrides — the defaults are below. All must be on the verified domain.
# EMAIL_FROM_ACCOUNTS="InstaDM247 <accounts@instadm247.com>"
# EMAIL_FROM_BILLING="InstaDM247 Billing <billing@instadm247.com>"
# EMAIL_FROM_ALERTS="InstaDM247 Alerts <alerts@instadm247.com>"
# EMAIL_REPLY_TO="support@instadm247.com"
